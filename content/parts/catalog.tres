ability_summary = "火力风暴：3秒橙红曳光连射，每秒20发（3tick间隔）；单发为当前普攻60%（四舍五入，至少1），随等级成长；100能量，需按住普攻，松手停火；结束红温散热1.5秒，禁止射击但可移动"
role_summary = "追踪压制；单发低，持续暴露，绕掩体断火线"
display_name = "速射机炮"
kind = 0
rarity = 0
unlock_rule_id = &"unlock_autocannon"
starter = false
basic_ready = true
ultimate_ready = true

