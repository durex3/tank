[sub_resource type="Resource" id="cannon"]
script = ExtResource("2")
id = &"cannon"
basic_summary = "炮塔：主战炮\n伤害：120/发\n发射间隔：0.80秒\n射程：14米\n弹匣/填弹：不限 / 不适用\n重量：2\n机制：弹速24；普通击退暂不改现有行为"
ability_summary = "邪能贯穿炮：蓄力0.45秒，发射一道红色穿刺能量束，最多贯穿3敌，240/144/86伤害，射程16米；100能量，蓄力移速60%，墙体阻挡"
role_summary = "稳定点射；射击间隔可被突进利用，掩体阻挡"
display_name = "主战炮"
kind = 0
rarity = 0
unlock_rule_id = &"starter"
starter = true
basic_ready = true
ultimate_ready = true

[sub_resource type="Resource" id="autocannon"]
