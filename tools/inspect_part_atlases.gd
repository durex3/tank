extends SceneTree

func _initialize() -> void:
	var manifest: Dictionary = {}
	for kind: int in range(2):
		var path: String = "res://assets/generated/parts/%s-atlas-v1.png" % ("turrets" if kind == 0 else "chassis")
		var image := (load(path) as Texture2D).get_image()
		var count: int = 22 if kind == 0 else 10
		var columns: int = 4
		var cell := Vector2i(image.get_width() / columns, image.get_height() / (6 if kind == 0 else 3))
		var entries := PartCatalog.entries_of(kind as PartEntry.Kind)
		for index: int in range(count):
			var origin := Vector2i(index % 4, index / 4) * cell
			if kind == 0:
				var edges: Array[int] = [0, 240, 480, 710, 960, 1200, image.get_height()]
				var row: int = index / 4
				origin.y = edges[row]
				cell.y = edges[row + 1] - edges[row]
			var low := cell
			var high := Vector2i.ZERO
			for y: int in range(cell.y):
				for x: int in range(cell.x):
					if image.get_pixel(origin.x + x, origin.y + y).a > 0.1:
						low = Vector2i(mini(low.x, x), mini(low.y, y))
						high = Vector2i(maxi(high.x, x), maxi(high.y, y))
			var used := Rect2i(low, high - low + Vector2i.ONE)
			var padded: Rect2i = used.grow(5).intersection(Rect2i(Vector2i.ZERO, cell))
			manifest[str(entries[index].id)] = [origin.x + padded.position.x, origin.y + padded.position.y, padded.size.x, padded.size.y]
		print("ATLAS_ALPHA ", kind, " corner=", image.get_pixel(0,0).a)
	var file := FileAccess.open("res://assets/generated/parts/frames.json", FileAccess.WRITE)
	file.store_string(JSON.stringify(manifest, "  "))
	var script_file := FileAccess.open("res://presentation/part_icon_frames.gd", FileAccess.WRITE)
	script_file.store_string("extends RefCounted\nclass_name PartIconFrames\n## Measured alpha bounds, generated by tools/inspect_part_atlases.gd.\n\nconst FRAMES: Dictionary = " + JSON.stringify(manifest, "\t") + "\n")
	print("ATLAS FRAMES: PASS")
	quit()
